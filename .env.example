# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Postgres container (docker-compose.yml)
POSTGRES_USER=jobpdf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobpdf
# Host port; use another one (e.g. 5433) if a local Postgres already listens on 5432.
POSTGRES_PORT=5432

# Used by scripts and db tests run on your own machine; must match the values above.
# Inside docker compose the containers use the "db" service instead (docker-compose.yml sets it).
# A password with special characters must be URL-encoded here.
DATABASE_URL=postgresql://jobpdf:change-me@localhost:5432/jobpdf

# The LLM key (CV reading and skill matching). Without it the API answers 503
# llm_not_configured and /health reports "down".
ANTHROPIC_API_KEY=
# linear (default) or learned (JM-27, needs fitted weights)
# JOBPDF_SCORER=linear

# API access (JM-30). Make a key with: uv run python scripts/make_api_key.py <name>
# One name:sha256hex entry per line or comma-separated; the server never stores the keys.
JOBPDF_API_KEYS=
# Or keep the entries in a file (e.g. a Docker secret):
# JOBPDF_API_KEYS_FILE=/run/secrets/jobpdf_api_keys
# At least 16 random characters; used to hash client IPs for the per-IP limit.
JOBPDF_RATE_LIMIT_SECRET=

# Job sources besides Remotive. A source with no key is skipped. Keys stay here, never in code or logs.
# The Muse: the key is optional (it only raises the rate limit).
THE_MUSE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=gb
# ADZUNA_QUERY=remote
JOOBLE_API_KEY=
# JOOBLE_KEYWORDS=remote
# JOOBLE_LOCATION=

# --- Running with docker compose (JM-36) -----------------------------------------------------
# The user id that owns ./data on this machine: APP_UID=$(id -u). The containers run as it.
APP_UID=1000
# The public name of the server. Caddy gets the HTTPS certificate for it once the name points
# at this machine and ports 80 and 443 are open. "localhost" is for trying it out.
DOMAIN=localhost
# Only for the Airflow profile: the web UI login and a random secret (python -c
# "import secrets; print(secrets.token_urlsafe(32))"). The UI listens on 127.0.0.1 only.
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_SECRET_KEY=
